[Unit]
Description=Dingtai CameraPipeline Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wuji-brain
WorkingDirectory=/home/wuji-brain/workspace
ExecStart=/home/wuji-brain/miniconda3/envs/wuji/bin/python -m camera_pipeline.service --bind-addr tcp://0.0.0.0:6200
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
